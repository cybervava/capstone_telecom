# Copy to .env — `make init` does this and replaces every `change-me` with a random value.
# Nothing in this file is a real secret. Never commit .env.

# --- Care platform -----------------------------------------------------------------------------
# dev enables the local token endpoint the demo console uses. Leave it unset anywhere else:
# the default is prod, where that endpoint does not exist.
CARE_ENV=dev
CARE_DB_HOST=127.0.0.1
CARE_DB_PORT=55432
CARE_DB_NAME=care
CARE_DB_USER=care
CARE_DB_PASSWORD=change-me
# Signs API tokens (HS256). In AWS this comes from Secrets Manager.
CARE_JWT_SECRET=change-me
CARE_API_HOST=127.0.0.1
CARE_API_PORT=8080

# --- OSS/BSS gateway (the mock stands in for the on-prem boundary) -----------------------------
CARE_OSS_BASE_URL=http://127.0.0.1:8081
# One key per agent identity. The gateway maps each key to a fixed scope set (least privilege).
OSS_KEY_TRIAGE=change-me
OSS_KEY_DIAGNOSTICS=change-me
OSS_KEY_RESOLUTION=change-me
OSS_KEY_DISPATCH=change-me
OSS_KEY_NOTIFICATION=change-me
OSS_KEY_INGEST=change-me
OSS_KEY_EXECUTOR=change-me
# Simulator controls only (scenario and fault injection). Not used by any agent.
OSS_KEY_ADMIN=change-me

# --- Mock gateway process ----------------------------------------------------------------------
MOCK_OSS_HOST=127.0.0.1
MOCK_OSS_PORT=8081
MOCK_OSS_DB=var/mock_oss.sqlite
MOCK_OSS_LINE_TEST_DELAY_MS=300-1500

# --- Policy and safety thresholds --------------------------------------------------------------
CARE_CREDIT_POLICY_PATH=data/policies/credit_policy.v0.yaml
# true = every credit waits for a human; credits above the policy limit always need a supervisor.
CARE_CREDIT_REVIEW_ALL=true
# A live network status older than this is not evidence (seconds).
CARE_STATUS_MAX_AGE_SECONDS=60
# The event feed is stale when no successful poll happened within this window (seconds).
CARE_FEED_MAX_AGE_SECONDS=90
# This many lines failing their remote test on one node within the window (seconds) is treated
# as a node fault the NOC has not declared yet. A line is not tested again sooner than
# CARE_LINE_RETEST_SECONDS.
CARE_LINE_TEST_CLUSTER_THRESHOLD=3
CARE_LINE_TEST_CLUSTER_WINDOW_SECONDS=900
CARE_LINE_RETEST_SECONDS=120
# A failed line on a node that looks healthy is watched this long before a repair is arranged:
# the time the NOC may need to declare an outage. Set it to e.g. 90 to show the hold in a demo.
CARE_DISPATCH_HOLD_SECONDS=600
# A contact whose network status could not be verified is looked at again this often (seconds),
# and handed to a person after this many looks without an answer.
CARE_NETWORK_RECHECK_SECONDS=60
CARE_NETWORK_RECHECK_LIMIT=5
# A suspected node fault gets this long to be declared or to clear before a person takes over.
CARE_SUSPECTED_WAIT_SECONDS=900
# A customer told about a declared outage hears of its end through the event feed; the live
# status is looked at this often as well, so a lost feed event cannot leave them waiting.
CARE_OUTAGE_RECHECK_SECONDS=900
# After "service restored" (or an unanswered question) a silent contact is closed after this long.
# Assumption: no closure rule has been supplied. Set it to e.g. 120 to show closure in a demo.
CARE_CLOSE_QUIET_SECONDS=86400
# "An outage has started" is not sent for a feed event older than this (seconds).
CARE_NOTIFY_MAX_EVENT_AGE_SECONDS=900

# --- LLM ---------------------------------------------------------------------------------------
# offline = deterministic rules and templates, no network, no key (default; used by tests and CI).
# anthropic = Claude through the official SDK; needs ANTHROPIC_API_KEY (or an `ant auth login` profile).
CARE_LLM_PROVIDER=offline
CARE_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
